# =====================================================================
# SmartCampus AI — variables d'environnement
# Copier ce fichier en .env (jamais commité) : cp .env.example .env
# =====================================================================

# --- Base de données -------------------------------------------------
# URL SQLAlchemy (driver psycopg 3). En Docker, docker-compose remplace
# "localhost" par le service "db". Port hôte 5433 (voir POSTGRES_HOST_PORT).
DATABASE_URL=postgresql+psycopg://smartcampus:smartcampus@localhost:5433/smartcampus
# Port publié sur le poste par le conteneur PostgreSQL (5433 pour ne pas gêner un PostgreSQL local)
POSTGRES_HOST_PORT=5433

# --- Sécurité / authentification -------------------------------------
# Clé de signature des JWT : chaîne longue et aléatoire, différente par environnement.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=remplacez-par-une-longue-chaine-aleatoire
# Durée de validité d'un jeton d'accès (minutes)
ACCESS_TOKEN_MINUTES=60
# Compte administrateur créé par scripts/seed.py (changer le mot de passe hors développement)
ADMIN_EMAIL=admin@smartcampus.local
ADMIN_PASSWORD=Admin123!

# --- Visiteurs sans compte et mémoire conversationnelle --------------
# Durée de vie d'une session anonyme (jours). Au-delà, la session non rattachée
# à un compte est purgée avec ses conversations (rétention temporaire).
VISITOR_SESSION_DAYS=7
# Nombre de derniers messages renvoyés au LLM à chaque tour (dialogue multi-tours)
CHAT_HISTORY_WINDOW=12

# --- LLM (toute API compatible OpenAI) --------------------------------
# openai = API compatible OpenAI (Ollama, Groq, vLLM...) ; fake = réponses simulées (tests)
LLM_PROVIDER=openai
# Ollama local : http://localhost:11434/v1 (en Docker : http://ollama:11434/v1)
# Groq         : https://api.groq.com/openai/v1
LLM_BASE_URL=http://localhost:11434/v1
# Ollama n'exige pas de clé (valeur quelconque) ; clé réelle pour un fournisseur distant
LLM_API_KEY=ollama
# Modèle utilisé par le chat (mis à jour à l'étape 14 après l'évaluation SA-31)
LLM_MODEL=qwen2.5:7b-instruct

# --- Synchronisation automatique du catalogue (sites officiels) -------
# Établissements synchronisés (codes séparés par des virgules)
SYNC_SITES=IIT,ISB,ISA,2I2S,NAU
# Intervalle entre deux synchronisations du service "scheduler" (heures)
SYNC_INTERVAL_HOURS=24
# true = le LLM complète les champs que les règles n'ont pas trouvés
# (chaque valeur proposée doit figurer dans le texte de la page, sinon rejetée)
SYNC_USE_LLM=false
# Pause entre deux requêtes vers un même site, en secondes (politesse du robot)
SYNC_REQUEST_DELAY_S=1.0
